{# esta plantilla hereda de base.html.twig #}
    {% extends 'base.html.twig' %}

    {# Sobreescribimos el titulo de la pagina, usamos la variable projectName, la
    cual vendra desde el controlador  
    #}
    {% block title %}{{ projectName }}{% endblock %}

    {# Inserto el cuerpo de la pagina de inicio #}
    {% block body %}
        <section class="hero">
            <p class ="eyebrow">IFCT092PO . Proyecto del curso</p>
            {# Project Name debe venir desde el controlador #}
            <h1>{{ projectName }}</h1>
            {# Messa #}
            <p>{{ message }}</p>
            {# Generamos el enlace a incidencias usando el nombre symfony de la ruta #}
            <p><a href="{{ path('app_ticket_index') }}">Ver incidencias</a></p>

        </section>
    {% endblock %}