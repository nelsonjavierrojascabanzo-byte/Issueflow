{#  Las demas pueden heredar esta estructura mediante {%  extends %}
    y sustituir unicamente los cloques que necesitan 
#}
<!DOCTYPE html>
<html lang="es">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        {# Las vistas hijas pueden reemplazar el titulo de la pagina #}
        <title>{% block title %}Issueflow{% endblock %}</title>

        {# Bloque reservado para scripts adicionales #}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# symfony 8.1 pueden trabajar con frankenphp hot reload
        este bloque solo se activa si la variable de servidor existe,
        por lo que no afecta a los alumnos que ejecuten PHP de otra forma
         #}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="site-header">
            <div class ="container header-inner">
                {#  path genera () genera la URL a partir del nombre interno de una ruta symfony #}
                <a class="brand" href="{{ path('app_home') }}">Issueflow</a>
                {#  Barra de navegacion principal #}
                <nav class="site-nav">
                        <a href="{{ path('app_home') }}">Inicio</a>
                        <a href="{{ path('app_ticket_index') }}">Incidencias</a>
                        <a href="{{ path('app_health') }}">Estado</a>
                </nav>
            </div>
        </header>

        <main class="site-main">
            <div class="container">
                ´{# aqui las vistas hijas colocan su contenido principal #}
                {% block body %}{% endblock %}
            </div>

        </main>
    </body>
</html>
