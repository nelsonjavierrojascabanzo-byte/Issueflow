<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}IssueFlow{% endblock %}</title>

    <style>
        body {
            background-color: #ffffff;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        nav {
            background-color: #042445;
            padding: 25px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-weight: bold;
            font-size: 22px;
            margin-left: 30px;
        }

        .menu a {
            color: white;
            margin-left: 20px;
            text-decoration: none;
            font-weight: bold;
            font-size: 17px;
        }

        .card {
            background: white;
            padding: 40px;
            margin: 40px auto;
            width: 85%;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }

        .hero {
            padding: 20px;
        }

        .eyebrow {
            font-size: 14px;
            color: #003366;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        h1 {
            font-size: 36px;
            color: #003366;
            margin-bottom: 10px;
        }

        p {
            font-size: 18px;
            color: #003366;
        }
    </style>
</head>

<body>

    <nav>
        <div class="logo">IssueFlow</div>

        <div class="menu">
            <a href="/">Inicio</a>
            <a href="/incidencias">Incidencias</a>
            <a href="/estado">Estado</a>
        </div>
    </nav>

    <div class="card">
        {% block body %}{% endblock %}
    </div>

</body>
</html>


